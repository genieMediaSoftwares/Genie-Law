{
  "name": "Frontend",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "android:release": "node scripts/android-build.js",
    "android:release:clean": "node scripts/android-build.js --clean",
    "android:release:device": "node scripts/android-build.js --device",
    "android:release:aab": "node scripts/android-build.js --aab",
    "check-env": "node scripts/check-env.js",
    "ios": "expo run:ios",
    "prebuild": "node scripts/prebuild-guard.js",
    "lint": "eslint .",
    "test": "jest",
    "start": "expo start --clear",
    "web": "vite build && vite preview --host 127.0.0.1 --port 5173",
    "web:build": "vite build",
    "web:preview": "vite preview --host 127.0.0.1 --port 5173",
    "web:watch": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "postinstall": "node scripts/patch-expo-modules.js"
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "3.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-documents/picker": "^12.0.2",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "expo": "^57.0.25",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-intent-launcher": "~57.0.1",
    "expo-localization": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.4.2",
    "nativewind": "^4.2.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.19.0",
    "jest": "29.7.0",
    "postcss": "^8.5.28",
    "prettier": "2.8.8",
    "react-native-dotenv": "^4.1.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "1.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
