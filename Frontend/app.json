{
  "expo": {
    "name": "Frontend",
    "slug": "Frontend",
    "version": "1.0.0",
    "scheme": "genielaw",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.anonymous.Frontend",
      "allowBackup": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Genie Law needs your microphone to record a voice note for the AI assistant."
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-localization"
    ]
  }
}
